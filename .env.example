# MailCraft AI — Root Environment Variables Example

# Copy this file to server/.env and fill in your values.
# This file is safe to commit. Your actual .env is in .gitignore.

# ─── NVIDIA NIM API Key ─────────────────────────────────────────────────────
# Get your free API key at: https://build.nvidia.com
# 1. Sign in / create a free account
# 2. Browse the model catalog (e.g., search "llama")
# 3. Click on a model → "Get API Key"
# 4. Paste below (keep the quotes if your key contains special characters)
NVIDIA_API_KEY=your_nvidia_api_key_here

# ─── JWT Secret ─────────────────────────────────────────────────────────────
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ─── Server Port ─────────────────────────────────────────────────────────────
PORT=3001

# ─── Client Origin (for CORS) ────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ─── Environment ─────────────────────────────────────────────────────────────
NODE_ENV=development
